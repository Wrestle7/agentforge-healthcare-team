# === LLM provider ===
LLM_PROVIDER=deepseek
# Leave blank to use the selected provider's built-in model and endpoint.
# If you customize either value, review BOTH when switching providers.
LLM_MODEL=
LLM_BASE_URL=
LLM_THINKING=false
LLM_MAX_TOKENS=4096

# Fill only the key for the selected provider.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

MAX_TOOL_RETRIES=2
RESPONSE_TIMEOUT=120

# === Local EHR mode ===
USE_MOCK_DATA=true

# === LangSmith observability (disabled locally) ===
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=agentforge-healthcare-local
LANGSMITH_PROJECT=agentforge-healthcare-local

# === Local API/security ===
API_KEYS=
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8501,http://localhost:8501
ENVIRONMENT=development
DATABASE_PATH=data/chat_history.db

# === OpenEMR FHIR API (ignored while USE_MOCK_DATA=true) ===
OPENEMR_BASE_URL=https://localhost:9300
OPENEMR_FHIR_URL=https://localhost:9300/apis/default/fhir
OPENEMR_TOKEN_URL=https://localhost:9300/oauth2/default/token
OPENEMR_CLIENT_ID=your-client-id
OPENEMR_CLIENT_SECRET=your-client-secret
OPENEMR_USERNAME=admin
OPENEMR_PASSWORD=pass
FHIR_VERIFY_SSL=true
OPENEMR_CONTAINER=

# === MariaDB/OpenEMR helper scripts ===
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=openemr
MARIADB_PASSWORD=openemr
MARIADB_DATABASE=openemr

# === Frontend ===
API_BASE_URL=http://127.0.0.1:8000
API_KEY=
