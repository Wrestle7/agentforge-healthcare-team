# === AgentForge Healthcare — Cloud Deployment (.env) ===
# Copy this file to .env and fill in your API keys.
# Used by docker-compose.cloud.yml

# === LLM Provider ===
LLM_PROVIDER=deepseek
# Leave blank to use the selected provider's built-in model and endpoint.
# If you customize either value, review BOTH when switching providers.
LLM_MODEL=
LLM_BASE_URL=
LLM_THINKING=false
LLM_MAX_TOKENS=4096
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# === LangSmith Observability ===
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=
LANGSMITH_API_KEY=

# === OpenEMR OAuth2 Credentials ===
# These are set AFTER registering an OAuth client in OpenEMR (Step 7 in plan).
# The docker-compose.cloud.yml overrides BASE_URL/FHIR_URL/TOKEN_URL to use
# Docker internal DNS (https://openemr), so you only need client creds here.
OPENEMR_CLIENT_ID=your-cloud-client-id
OPENEMR_CLIENT_SECRET=your-cloud-client-secret
